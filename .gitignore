# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Virtual environment
venv/
.env/
env/

# VS Code settings
.vscode/

# macOS system files
.DS_Store

# Python egg info
*.egg-info/
*.egg

# Environment variables (if used)
*.env

# Log files
*.log

# Pytest cache
.pytest_cache/

# Dashboard (Vite + React)
dashboard/node_modules/
dashboard/*.tsbuildinfo

# Generated weekly by the notebook's Export cell (utils/dashboard.py).
# Both copies exist because Vite serves public/ in dev and dist/ in a build.
dashboard/public/data/slate.js
dashboard/dist/data/slate.js

# Lineups live in personal OneDrive now (Fantasy Golf/Lineup_Optimizer), so
# they sync between computers without a commit and a pull. This entry only
# covers the fallback location used when a machine has no personal OneDrive
# (a work account does not count — it cannot sync to the home PC) — the file
# is autosaved constantly, and tracking it made the working tree dirty every
# time the dashboard was so much as opened.
data/lineups/

# NOTE: dashboard/dist/index.html is deliberately NOT ignored. It only changes
# when the UI changes — not weekly — and committing it means the other computer
# can pull and open the dashboard without installing Node at all. Node is then
# only needed to develop the UI, not to use it.
